<% layout("/layouts/boilerplate") %>
  <script>
    const mapToken = "<%= process.env.MAP_ACCESS_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>
  </script>

  <body>
    <div class="row">
      <div class="col-8 offset-2">
        <br />
        <h3>
          <%= listing.title %>
        </h3>
        <hr />
        <br />
        <div class="card listing-card mb-3">
          <h5 class="card-title"></h5>
          <img src="<%= listing.image.url %>" class="card-img-top" alt="image" style="height: 20rem" />
          <div class="card-body">
            <p class="card-text">
              <b>Description : </b>
              <%= listing.description %>
            </p>
            <p class="card-text">
              <i class="fa-solid fa-location-dot"></i>
              <small class="text-body-secondary">
                <%= listing.location %>, <%= listing.country %>
              </small>
            </p>
            <p class="card-text">
              <b>Price :</b>
              <small class="text-body-secondary">
                &#8377; <%= listing.price.toLocaleString('en-IN') %>
              </small>
            </p>
            <p class="card-text">
              <b><i class="fa-solid fa-envelope"></i></b>
              <small class="text-body-secondary">
                <b>Contact to Owner : </b>
                <%= listing.owner.email %> %>
              </small>
            </p>
          </div>
        </div>
        <%if(currUser && listing.owner._id.equals(currUser._id)){ %>
          <div class="row">
            <div class="col-md-4 col-12 mb-3">
              <form action="/listings/<%= listing._id %>/edit" method="get">
                <button type="submit" class="btn btn-primary add-btn w-100">
                  Edit the listing
                </button>
              </form>
            </div>
            <div class="col-md-4 col-12 mb-3">
              <form action="/listings/<%= listing._id %>?_method=delete" method="post">
                <button type="submit" class="btn btn-primary del-btn w-100">
                  Delete the listing
                </button>
              </form>
            </div>
          </div>
          <% } %>
      </div>
    </div>
    <br />
    <br />

    <% if(currUser) { %>
      <div class="row">
        <div class="col-8 offset-2 mb-5">
          <h4>Share your Review <i class="fa-solid fa-heart"></i></h4>
          <hr />
          <form action="/listings/<%= listing._id %>/reviews" method="post" class="needs-validation" novalidate>
            <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" min="1" max="5"
                  checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
              <div class="mb-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea type="text" name="review[comment]" id="comment" rows="5" cols="30" class="form-control"
                  required></textarea>
                <div class="invalid-feedback">
                  Please add some comments for review
                </div>
              </div>
              <button type="submit" class="btn btn-outline-dark">Share Review</button>
            </div>
          </form>
        </div>
      </div>
      <% } %>

        <% if(listing.reviews.length> 0){ %>
          <div class="row">
            <div class="col-8 offset-2 mb-5">
              <h4>Customer's Reviews <i class="fa-solid fa-heart"></i></h4>
              <hr />
              <div class="mt-5">
                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 justify-content-center">
                  <% for(review of listing.reviews) { %>
                    <div class="col d-flex justify-content-center">
                      <div class="card" style="width: 18rem">
                        <div class="card-header mb-3">
                          <h5 class="card-title">
                            <i class="fa-solid fa-user"></i>
                            <%= review.author.username %>
                          </h5>
                        </div>
                        <div class="card-body ms-3">
                          <p class="card-text">
                            <%= review.comment %>
                          </p>
                          <p class="card-text">
                            <%= review.rating %> / 5.0
                          </p>
                          <p class="starability-result" data-rating="<%= review.rating %>"></p>
                          <%if(currUser && review.author._id.equals(currUser._id)){ %>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=delete"
                              method="post">
                              <button type="submit" class="btn btn-outline-dark mb-1">
                                Delete Review
                              </button>
                            </form>
                            <% } %>
                        </div>

                        <div class="card-footer text-body-secondary">Created at</div>
                      </div>
                    </div>
                    <% } %>
                </div>
              </div>
            </div>
          </div>
          <% } %>

            <div class="row">
              <div class="col-8 offset-2 mb-5">
                <h4>Were you'll be <i class="fa-solid fa-location-crosshairs" style="color: #fe424d;"></i></h4>
                <hr />
                <div id="map"></div>
              </div>
            </div>

    <script src="/js/map.js"></script>
  </body>
