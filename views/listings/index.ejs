<% layout("/layouts/boilerPlate") %>
<body>
  <div class="row">
    <div class="col-lg-10 offset-lg-1">
      <br />
      <h3 class="text-center">
        Stay, Relax & Explore - Your Perfect Getaway Awaits!
        <i class="fa-solid fa-hotel" style="color: #fe424d"></i>
      </h3>
      <hr />
      <div id="filters-container">
        <button id="left-btn" class="scroll-btn">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div id="filters">
          <div class="filter">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-city"></i>
            <p>Iconic Cities</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-umbrella-beach"></i>
            <p>Beach</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-person-swimming"></i>
            <p>Amazing Pools</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-shuttle-space"></i>
            <p>OMG!</p>
          </div>
          <div class="filter">
            <i class="fa-brands fa-fort-awesome"></i>
            <p>Castles</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-tree"></i>
            <p>Treehouses</p>
          </div>
          <div class="filter">
            <i class="fa-brands fa-canadian-maple-leaf"></i>
            <p>National Parks</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-umbrella-beach"></i>
            <p>Islands</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-caret-up"></i>
            <p>Caves</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-sailboat"></i>
            <p>Boats</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-ferry"></i>
            <p>Houseboats</p>
          </div>
          <div class="filter">
            <i class="fa-solid fa-tower-cell"></i>
            <p>Towers</p>
          </div>
        </div>
        <button id="right-btn" class="scroll-btn">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input
            class="form-check-input"
            type="checkbox"
            role="switch"
            id="flexSwitchCheckDefault"
          />
          <label class="form-check-label" for="flexSwitchCheckDefault"
            > <b><i>Display total before taxes</i></b> <i class="tax-info"> + 18% GST </i></label
          >
        </div>
      </div>
      <br />
      <div
        class="row row-cols-lg-3 row-cols-md-2 row-cols-1 justify-content-center"
      >
        <%for(let listing of allListings){%>
        <div class="col d-flex justify-content-center mb-4">
          <div class="card listing-card" style="width: 20rem">
            <img
              src="<%= listing.image.url %>"
              class="card-img-top"
              alt="image"
              style="height: 20rem; object-fit: cover"
            />
            <div class="card-body text-center">
              <h5 class="card-title"><b> <%= listing.title %> </b></h5>
              <p class="card-text">
                <i class="oldPrice"> &#8377; <%= listing.price.toLocaleString('en-IN') %> </i>
                <% let priceAfterTax = listing.price * 1.18; %>
                <% let formattedPrice = priceAfterTax.toLocaleString('en-IN'); %>
                <i class="tax-info"> &nbsp; &nbsp; <b>&#8377; <%= formattedPrice %></b></i>
                <i>/ night </i> 
              </p>
              <a
                href="/listings/<%= listing._id%>"
                class="btn btn-primary add-btn"
              >
                View Details
              </a>
            </div>
          </div>
        </div>
        <%}%>
      </div>
    </div>
  </div>
</body>
